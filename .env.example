# LLM Provider: "gemini" or "local"
LLM_PROVIDER=gemini

# Gemini API Keys — comma-separated list for rotation
# When one key hits a quota/rate limit, the next is tried automatically
GEMINI_API_KEYS=key1,key2,key3,key4,key5

# Gemini model name
GEMINI_MODEL=gemini-2.0-flash

# Local LLM base URL (required if LLM_PROVIDER=local, e.g. Ollama)
LOCAL_LLM_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=llama3

# Upload limits
MAX_ZIP_SIZE_MB=50
MAX_UNCOMPRESSED_SIZE_MB=500
MAX_FILE_COUNT=1000
MAX_SINGLE_FILE_SIZE_MB=1

# Analysis
DEFAULT_QUESTIONS_PER_SKILL=3
CONFIDENCE_THRESHOLD=0.3

# Logging
LOG_LEVEL=INFO
