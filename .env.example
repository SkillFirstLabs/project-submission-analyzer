# ===========================
# LLM Provider Configuration
# ===========================
# Options: "gemini", "anthropic", "openai", or "groq"
LLM_PROVIDER=gemini

# ===========================
# Anthropic API Configuration (Claude Opus)
# ===========================
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY
ANTHROPIC_MODEL=claude-opus-4-1-20250805
ANTHROPIC_API_BASE_URL=https://api.anthropic.com

# ===========================
# Gemini API Configuration (Alternative)
# ===========================
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.0-flash

# ===========================
# OpenAI API Configuration (Alternative)
# ===========================
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-4o-mini

# ===========================
# Groq API Configuration (Alternative)
# ===========================
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_MODEL=llama-3.3-70b-versatile

# ===========================
# Application Configuration
# ===========================
APP_NAME=AI Project Evaluation API
APP_VERSION=1.0.0
DEBUG=True
LLM_VERIFY_SSL=true
